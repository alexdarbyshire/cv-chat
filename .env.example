# =====================================================================
# cv-chat — environment variables
# Copy to `.env.local` and populate. Never commit `.env`/`.env.local`.
# =====================================================================

# --- Auth.js ---------------------------------------------------------
# generate via: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (signed-in tier). Create at:
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- AI Gateway (Vercel) ---------------------------------------------
# Routes both chat (Claude Sonnet) and embeddings (text-embedding-3-small).
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Optional model overrides (must be available on the gateway).
# CV_CHAT_MODEL=anthropic/claude-sonnet-4-6
# CV_CHAT_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Reranker (SPEC §7 Phase 7) -------------------------------------
# Cross-encoder rerank pass over pgvector top-k, brokered by the AI
# Gateway (Cohere rerank-v3.5 by default; see GatewayRerankingModelId
# for alternatives). Uses the same AI_GATEWAY_API_KEY as chat — no
# extra credential. Defaults to `on`; set `off` to skip the rerank call
# entirely (forks that don't want any rerank cost can ship with this
# off). Failures fall through to pgvector order with a single warning.
# CV_CHAT_RERANK=on

# --- Database (Neon Postgres + pgvector) -----------------------------
POSTGRES_URL=

# --- Rate limiting (Upstash Redis) -----------------------------------
REDIS_URL=

# --- Vercel Blob (caches generated tailored-resume PDFs) --------------
# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=

# --- Persona (drives system prompt + UI; safe to commit per-fork) ----
PERSONA_NAME="Alex Darbyshire"
PERSONA_BLOG_URL=https://alexdarbyshire.com
PERSONA_GITHUB_URL=https://github.com/alexdarbyshire
PERSONA_LINKEDIN_URL=

# Optional system-prompt overrides. Defaults are baked into lib/persona.ts and
# match the canonical cv-chat deployment; forks override here when needed.
# PERSONA_BIO="Backstory paragraph the bot can lean on when retrieval is sparse."
# PERSONA_TRANSFERABILITY="Notes on how the persona's experience generalises (e.g. cloud providers, language families)."
# PERSONA_CONTACT_POLICY="Rules the bot follows when asked for contact details."

# --- Owner detection -------------------------------------------------
# Email of the persona's owner. When a signed-in user matches, retrieval
# includes private-tier corpus chunks. Anonymous/guest sessions and other
# regular users only see public-tier chunks regardless of this value.
# OWNER_EMAIL=you@example.com

# --- Corpus (private; never committed to this repo) -------------------
# Local path or git+ssh URL to your career corpus repo. Used by `pnpm ingest`.
CORPUS_PATH=

# --- Tailored resume PDF ---------------------------------------------
# Public URL to the canonical static resume; used as fallback when generation fails.
STATIC_RESUME_URL=
# Override the default typst template; ships with the repo.
# RESUME_TEMPLATE_PATH=templates/resume.typ

# --- UX flags --------------------------------------------------------
# Show the in-composer model picker. Hidden by default — the visitor doesn't
# need to choose a model. Set to 1 to expose the trigger (e.g. for dev/demo);
# the picker plumbing is always wired so this is a one-line gate. See SPEC §3.4a.
CV_CHAT_SHOW_MODEL_PICKER=0

# --- Dev: reverse-proxy hostnames ------------------------------------
# Comma-separated public hostnames that front the dev server (e.g. via Traefik/
# Caddy/ngrok terminating TLS and forwarding to :3000). Required so Next.js dev
# accepts HMR + server-action requests under those hostnames. Leave blank if
# you only access via http://localhost:3000.
# DEV_ALLOWED_ORIGINS=cv.example.test
