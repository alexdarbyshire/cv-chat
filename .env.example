# =====================================================================
# cv-chat — environment variables
# Copy to `.env.local` and populate. Never commit `.env`/`.env.local`.
# =====================================================================

# --- Auth.js ---------------------------------------------------------
# generate via: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (signed-in tier). Create at:
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- AI Gateway (Vercel) ---------------------------------------------
# Routes both chat (Claude Sonnet) and embeddings (text-embedding-3-small).
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Optional model overrides (must be available on the gateway).
# CV_CHAT_MODEL=anthropic/claude-sonnet-4-6
# CV_CHAT_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Database (Neon Postgres + pgvector) -----------------------------
POSTGRES_URL=

# --- Rate limiting (Upstash Redis) -----------------------------------
REDIS_URL=

# --- Vercel Blob (caches generated tailored-resume PDFs) --------------
# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=

# --- Persona (drives system prompt + UI; safe to commit per-fork) ----
PERSONA_NAME="Alex Darbyshire"
PERSONA_BLOG_URL=https://alexdarbyshire.com
PERSONA_GITHUB_URL=https://github.com/alexdarbyshire
PERSONA_LINKEDIN_URL=

# --- Corpus (private; never committed to this repo) -------------------
# Local path or git+ssh URL to your career corpus repo. Used by `pnpm ingest`.
CORPUS_PATH=

# --- Tailored resume PDF ---------------------------------------------
# Public URL to the canonical static resume; used as fallback when generation fails.
STATIC_RESUME_URL=
# Override the default typst template; ships with the repo.
# RESUME_TEMPLATE_PATH=templates/resume.typ

# --- Dev: reverse-proxy hostnames ------------------------------------
# Comma-separated public hostnames that front the dev server (e.g. via Traefik/
# Caddy/ngrok terminating TLS and forwarding to :3000). Required so Next.js dev
# accepts HMR + server-action requests under those hostnames. Leave blank if
# you only access via http://localhost:3000.
# DEV_ALLOWED_ORIGINS=cv.example.test
